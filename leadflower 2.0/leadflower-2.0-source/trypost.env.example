# Trypost deployment configuration — EXAMPLE ONLY.
#
# Copy to trypost.env and fill in. trypost.env is gitignored and must never be
# committed: the previous committed copy contained a live Passport RSA private
# key, APP_KEY and database password, and must be treated as compromised.

APP_PORT=8001
REVERB_PORT=8081
VITE_PORT=5174
FORWARD_DB_PORT=5433
FORWARD_REDIS_PORT=6380
FORWARD_MAILPIT_SMTP_PORT=1026
FORWARD_MAILPIT_UI_PORT=8026

APP_ENV=production
APP_DEBUG=false
APP_URL=https://social.example.com

DB_CONNECTION=pgsql
DB_PORT=5432
DB_DATABASE=trypost
DB_USERNAME=
DB_PASSWORD=

# php artisan key:generate
APP_KEY=

# Shared secret between LeadFlower and Trypost. Minimum 32 characters.
# Must match TRYPOST_ADMIN_API_KEY on the LeadFlower side.
# Generate with: openssl rand -base64 48
LEADFLOWER_SSO_SECRET=

# php artisan passport:keys — never commit the generated keys.
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=
