NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173

MONGO_URI=mongodb://mongo:27017/logicflower
REDIS_URL=redis://redis:6379

# Generate at least 32 random bytes for each secret.
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
ENCRYPTION_KEY=replace-with-64-hex-characters

# Envelope encryption. `local` derives versioned data keys from ENCRYPTION_KEY
# via HKDF and needs no external service. `aws-kms` wraps data keys with a KMS
# master key and requires the keyring to initialise at boot.
KMS_PROVIDER=local
# KMS_MASTER_KEY_ID=arn:aws:kms:us-east-1:000000000000:key/replace-me
KMS_REGION=us-east-1
# Increment to rotate. Prior versions stay readable; nothing needs re-encrypting
# for the system to keep working. Run `npm run rotate:rewrap --prefix server`
# afterwards to shorten the tail of data still on the old key.
ENCRYPTION_KEY_VERSION=1

# Runtime secret store. `environment` reads nothing extra. `aws-secrets-manager`
# and `vault` load a flat JSON bundle before typed config is parsed. Values
# already present in the environment always win over the store.
SECRET_STORE_DRIVER=environment
# SECRET_STORE_REFERENCE=logicflower/production
# VAULT_ADDR=https://vault.internal:8200
# VAULT_TOKEN=replace-with-a-vault-token
# VAULT_MOUNT=secret
COOKIE_SECURE=false
ALLOW_REGISTRATION=false
TRUST_PROXY=0

# Namespace for RFC 7807 problem type URIs. A URN by default so that no
# unverified domain or trademark is committed into the public API contract
# ([V43], [V44]). Set to an https namespace only after clearance.
PROBLEM_TYPE_BASE_URI=urn:logicflower:problem

# Connector release states, comma separated as provider:state.
# Valid states: general, quarantined, disabled.
# ActiveCampaign defaults to quarantined pending the [V14] API licence review;
# it accepts no new connections and performs no writes until changed here.
# Example after sign-off: CONNECTOR_RELEASE_STATES=

# Provider webhook signing keys. Published defaults are embedded; set these to
# survive a provider key rotation without a redeploy. `\n` escapes are accepted
# so a PEM can be supplied on a single line.
# GHL_WEBHOOK_PUBLIC_KEY=
# GHL_LEGACY_WEBHOOK_PUBLIC_KEY=
# Reject a webhook whose signed payload carries no usable timestamp. Durable
# event-id de-duplication stops being a replay defence once the retention
# worker purges the event record.
WEBHOOK_REQUIRE_TIMESTAMP=true

# Onboarding contact-scan ceiling. Truncation is always reported to the user.
CONNECTION_SCAN_LIMIT=5000
CONNECTION_SCAN_MAX_LIMIT=100000

# [V3] contingency. Set false when HighLevel does not grant workflows.readonly:
# the product falls back to Batch plus connection-health Watch cleanly rather
# than offering workflow monitoring that cannot function.
FEATURE_WATCH_WORKFLOWS_ENABLED=true

# Backup automation (server/scripts/backup/).
# BACKUP_S3_BUCKET=logicflower-backups
# BACKUP_S3_PREFIX=logicflower/backups
# BACKUP_REGION=us-east-1
# BACKUP_REPLICA_BUCKET=logicflower-backups-dr
# BACKUP_REPLICA_REGION=eu-west-1
# BACKUP_ENCRYPTION_PASSPHRASE=replace-with-a-long-random-passphrase
# BACKUP_RETENTION_DAYS=35activecampaign:general
CONNECTOR_RELEASE_STATES=

# Provider webhook signing keys. Published defaults are embedded; set these to
# survive a provider key rotation without a redeploy. `\n` escapes are accepted
# so a PEM can be supplied on a single line.
# GHL_WEBHOOK_PUBLIC_KEY=
# GHL_LEGACY_WEBHOOK_PUBLIC_KEY=
# Reject a webhook whose signed payload carries no usable timestamp. Durable
# event-id de-duplication stops being a replay defence once the retention
# worker purges the event record.
WEBHOOK_REQUIRE_TIMESTAMP=true

# Onboarding contact-scan ceiling. Truncation is always reported to the user.
CONNECTION_SCAN_LIMIT=5000
CONNECTION_SCAN_MAX_LIMIT=100000

# [V3] contingency. Set false when HighLevel does not grant workflows.readonly:
# the product falls back to Batch plus connection-health Watch cleanly rather
# than offering workflow monitoring that cannot function.
FEATURE_WATCH_WORKFLOWS_ENABLED=true

# Backup automation (server/scripts/backup/).
# BACKUP_S3_BUCKET=logicflower-backups
# BACKUP_S3_PREFIX=logicflower/backups
# BACKUP_REGION=us-east-1
# BACKUP_REPLICA_BUCKET=logicflower-backups-dr
# BACKUP_REPLICA_REGION=eu-west-1
# BACKUP_ENCRYPTION_PASSPHRASE=replace-with-a-long-random-passphrase
# BACKUP_RETENTION_DAYS=35

# Live acceptance probes (npm run acceptance --prefix server).
# ACCEPTANCE_HOSTNAME=app.example.com
# ACCEPTANCE_API_URL=https://api.example.com
# ACCEPTANCE_EMAIL_TO=deliverability@example.com
# ACCEPTANCE_EVIDENCE_DIR=./acceptance-evidence

# Encrypted artifact storage. Local requires a durable mounted volume; S3 also
# supports S3-compatible providers through ARTIFACT_S3_ENDPOINT.
ARTIFACT_STORAGE_DRIVER=local
ARTIFACT_LOCAL_ROOT=/var/lib/logicflower/artifacts
ARTIFACT_MAX_BYTES=104857600
ARTIFACT_S3_BUCKET=
ARTIFACT_S3_REGION=us-east-1
ARTIFACT_S3_ENDPOINT=
ARTIFACT_S3_FORCE_PATH_STYLE=false
ARTIFACT_S3_KMS_KEY_ID=

# Optional bootstrap owner. Used only by the explicit bootstrap command.
BOOTSTRAP_EMAIL=owner@example.com
BOOTSTRAP_PASSWORD=replace-before-use

# Email delivery. Mailpit values work with docker compose in development.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=LogicFlower <no-reply@logicflower.local>

# Stripe billing (optional until configured).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_SCALE=

# OAuth application credentials. Tokens are stored encrypted per connection.
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REDIRECT_URI=http://localhost:4000/api/v1/connections/ghl/oauth/callback
GHL_OAUTH_SCOPES=contacts.readonly contacts.write locations.readonly workflows.readonly

HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:4000/api/v1/connections/hubspot/oauth/callback
HUBSPOT_OAUTH_SCOPES=crm.objects.contacts.read crm.objects.contacts.write automation

KLAVIYO_CLIENT_ID=
KLAVIYO_CLIENT_SECRET=
KLAVIYO_REDIRECT_URI=http://localhost:4000/api/v1/connections/klaviyo/oauth/callback
KLAVIYO_OAUTH_SCOPES=profiles:read profiles:write events:write flows:read

# ActiveCampaign uses a per-account API token + HTTPS account API URL.
# Store these through /api/v1/connections; do not place them in environment files.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/connections/google/oauth/callback

# Operational controls.
LOG_LEVEL=info
MONITOR_INTERVAL_MS=900000
WORKFLOW_MAX_STEPS=250
WEBHOOK_MAX_AGE_SECONDS=300
WORKFLOW_CONCURRENCY=10
BATCH_CONCURRENCY=4
MONITORING_CONCURRENCY=2
NOTIFICATION_CONCURRENCY=5
OUTBOUND_HTTP_ALLOWLIST=

# ---------------------------------------------------------------------------
# Sequence engine (LeadFlower Phase 1)
# ---------------------------------------------------------------------------
#
# The sequence engine sends email, SMS and WhatsApp under the OPERATOR'S OWN
# provider credentials, not the platform's and not the customer's CRM. Those
# credentials are held per organisation, encrypted, and configured through
# /api/v1/sequences/identities. There is deliberately no environment variable
# for a tenant sending credential: one here would be shared by every tenant and
# would let a customer's campaign mail leave under the platform's domain.
#
# The SMTP_* settings above remain platform-only, for password resets and
# invitations, and are not reachable from the sequence engine.

# Master switch. Off by default: turning this on starts sending messages to
# real people. Leave it off until at least one sending identity is configured
# and its provider has been verified against a live account.
SEQUENCE_ENGINE_ENABLED=false

# How often the scheduler polls MongoDB for steps that have come due. This is
# the worst-case latency between a step becoming due and being sent. The
# scheduler polls the database rather than consuming a Redis queue on purpose:
# Redis is a work queue here, MongoDB is the source of truth, and losing Redis
# entirely must lose nothing. Shorter costs database reads; longer costs
# punctuality. For sequences measured in hours and days, 15s is generous.
SEQUENCE_SCHEDULER_INTERVAL_MS=15000

# Maximum steps drained per tick. Bounds how long one pass holds leases open,
# so a large backlog is drained across several ticks and shutdown stays clean.
SEQUENCE_SCHEDULER_BATCH=50

# How long a worker may hold a claimed step before another worker may reclaim
# it. Must comfortably exceed the slowest provider call. Set too low, a healthy
# but slow send gets reclassified as an unknown outcome and stalls the
# enrolment; set too high, a genuinely dead worker's steps sit idle for that
# long before recovery.
SEQUENCE_STEP_LEASE_MS=120000

# ---------------------------------------------------------------------------
# Social publishing backend (self-hosted trypost)
# ---------------------------------------------------------------------------
#
# trypost (https://github.com/trypost-it/trypost) is AGPL-3.0-only and runs as a
# SEPARATE service with its own PHP runtime and relational database. This
# platform speaks to it over HTTP and shares no database with it.
#
# LICENSING: calling its REST API across a process boundary is ordinary
# integration. MODIFYING trypost — including rebranding it — produces changes
# that are themselves AGPL and must be offered as source to anyone who uses them
# over a network. Take legal advice before forking it.
#
# THIS DOES NOT REMOVE THE NEED FOR APP REVIEW. trypost publishes using YOUR
# approved platform apps; its own configuration expects FACEBOOK_CLIENT_ID,
# INSTAGRAM_CLIENT_SECRET and so on. Nothing publishes until those apps are
# approved by each platform.
#
# Leave unset to disable social publishing entirely. Posts can still be composed
# and scheduled; they will report as blocked rather than publishing.
TRYPOST_BASE_URL=
# Admin key, used only for connectivity checks. Each organisation's own
# workspace key is stored encrypted against that organisation and is never
# defaulted to this one — workspace keys are tenant-scoped.
TRYPOST_ADMIN_API_KEY=
TRYPOST_TIMEOUT_MS=20000
# trypost has no outbound webhook, so publish status is polled at this interval.
TRYPOST_POLL_INTERVAL_MS=60000

# ---------------------------------------------------------------------------
# Outbound voice dialer
# ---------------------------------------------------------------------------
#
# Off by default. Enabling it starts evaluating the regulatory gate chain
# against real contacts.
DIALER_ENABLED=false
DIALER_INTERVAL_MS=30000
DIALER_BATCH=10
#
# DRY RUN defaults to TRUE and should stay true until every gate has been
# validated against real data. With it on, every gate is evaluated and every
# decision recorded to the audit trail — suppression, consent, DND registry,
# calling window — and NO call is placed.
#
# This is the safe way to answer "which of our contacts would this actually
# call, and why" before a single phone rings. Given no telephony provider is
# implemented in this build, turning it off changes nothing except that the
# dialer will attempt a provider call and record the refusal.
DIALER_DRY_RUN=true

# ---------------------------------------------------------------------------
# Platform administration
# ---------------------------------------------------------------------------
#
# Whether corporate actions — the Estate console, the public website editor and
# the admin portal — demand a second factor.
#
# Leave true. Setting it false means a stolen platform password is enough to
# enumerate every tenant and publish to your own marketing domain. It logs a
# warning on start-up so the state is visible rather than forgotten.
#
# If MFA is blocking a deployment, the fix is to enrol MFA on the corporate
# account, not to turn this off.
CORPORATE_MFA_REQUIRED=true

# Permit the social publishing backend over plain HTTP.
#
# The shared secret travels in the request body, so over HTTP it is readable by
# anything on the path and is enough to mint a session as any user. Leave false
# unless trypost sits on a private network where the hop genuinely cannot be
# observed. The correct fix is TLS, not this flag.
TRYPOST_ALLOW_INSECURE=false

# ---------------------------------------------------------------------------
# Public site metadata (build-time, set on the CLIENT build)
# ---------------------------------------------------------------------------
#
# CANONICAL_ORIGIN — your public origin, e.g. https://example.com
#   Prerendered pages use it for canonical and og:url. Without it those are
#   relative, which most crawlers and every social scraper ignore.
#
# SOCIAL_IMAGE_PATH — path to the share card, default /ecosystem.jpg
#   Ideally a purpose-built 1200x630 image. Combined with CANONICAL_ORIGIN to
#   form an absolute og:image; a relative one produces a blank card, and a blank
#   card reads as a broken link.

# Minimum length for the trypost shared secret. Lower it only deliberately —
# the secret is enough to mint a session as any user, and the correct fix for a
# blocked deployment is `npm run secrets:generate`.
TRYPOST_MIN_SECRET_LENGTH=32
