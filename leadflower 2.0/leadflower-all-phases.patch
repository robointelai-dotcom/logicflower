+    ContactNote.find({ organizationId, contactId }).sort({ pinned: -1, createdAt: -1 }).limit(50).lean(),
+    SequenceEnrolment.find({ organizationId, contactId }).sort({ createdAt: -1 }).limit(50).lean(),
