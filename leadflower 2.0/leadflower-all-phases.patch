+  const hasMore = rows.length > limit
+  res.json({
+    reviews: rows.slice(0, limit).map((row) => ({
+      id: String(row._id),
+      rating: row.rating,
+      body: row.body,
+      authorName: row.authorName,
+      source: row.source,
+      publishState: row.publishState,
+      contactId: row.contactId ? String(row.contactId) : null,
