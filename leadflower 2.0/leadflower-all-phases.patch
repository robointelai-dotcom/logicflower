+    messages: messages.map((row: any) => ({ id: String(row._id), channel: row.channel, status: row.status, recipientPreview: row.recipientPreview, sentAt: row.sentAt, deliveredAt: row.deliveredAt, bouncedAt: row.bouncedAt })),
