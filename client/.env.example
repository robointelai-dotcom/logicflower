# ---- Automation Platform (Client) .env example ----
# Vite variables must start with VITE_*
VITE_APP_NAME=Automation Platform
# API base is proxied via vite.config.ts; normally no need to change.
# If you deploy static and server under same domain, keep /api
VITE_API_BASE=/api/v1
VITE_SUPPORT_EMAIL=support@logicflower.com
