{
  "name": "automation-platform-server",
  "version": "1.1.3",
  "private": true,
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "worker": "nodemon --watch src --ext ts --exec ts-node src/queue/processor.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bootstrap": "node dist/scripts/bootstrap.js",
    "bootstrap:dev": "ts-node scripts/bootstrap.ts",
    "migrate:tenancy": "node dist/scripts/migrate-tenancy.js",
    "migrate:tenancy:dev": "ts-node scripts/migrate-tenancy.ts",
    "env:check": "ts-node scripts/check-env.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "acceptance": "ts-node scripts/acceptance/runAcceptance.ts",
    "rotate:rewrap": "ts-node scripts/rotate-keys.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1103.0",
    "@aws-sdk/client-s3": "^3.1103.0",
    "@aws-sdk/client-secrets-manager": "^3.1103.0",
    "axios": "^1.7.2",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.7.9",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.4",
    "otplib": "^12.0.1",
    "pino": "^9.3.2",
    "stripe": "^22.4.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.11",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.3",
    "ioredis-mock": "^8.13.1",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "vitest": "^3.2.4"
  }
}
