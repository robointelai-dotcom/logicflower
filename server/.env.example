NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173

MONGO_URI=mongodb://mongo:27017/logicflower
REDIS_URL=redis://redis:6379

# Generate at least 32 random bytes for each secret.
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
ENCRYPTION_KEY=replace-with-64-hex-characters

# Envelope encryption. `local` derives versioned data keys from ENCRYPTION_KEY
# via HKDF and needs no external service. `aws-kms` wraps data keys with a KMS
# master key and requires the keyring to initialise at boot.
KMS_PROVIDER=local
# KMS_MASTER_KEY_ID=arn:aws:kms:us-east-1:000000000000:key/replace-me
KMS_REGION=us-east-1
# Increment to rotate. Prior versions stay readable; nothing needs re-encrypting
# for the system to keep working. Run `npm run rotate:rewrap --prefix server`
# afterwards to shorten the tail of data still on the old key.
ENCRYPTION_KEY_VERSION=1

# Runtime secret store. `environment` reads nothing extra. `aws-secrets-manager`
# and `vault` load a flat JSON bundle before typed config is parsed. Values
# already present in the environment always win over the store.
SECRET_STORE_DRIVER=environment
# SECRET_STORE_REFERENCE=logicflower/production
# VAULT_ADDR=https://vault.internal:8200
# VAULT_TOKEN=replace-with-a-vault-token
# VAULT_MOUNT=secret
COOKIE_SECURE=false
ALLOW_REGISTRATION=false
TRUST_PROXY=0

# Namespace for RFC 7807 problem type URIs. A URN by default so that no
# unverified domain or trademark is committed into the public API contract
# ([V43], [V44]). Set to an https namespace only after clearance.
PROBLEM_TYPE_BASE_URI=urn:logicflower:problem

# Connector release states, comma separated as provider:state.
# Valid states: general, quarantined, disabled.
# ActiveCampaign defaults to quarantined pending the [V14] API licence review;
# it accepts no new connections and performs no writes until changed here.
# Example after sign-off: CONNECTOR_RELEASE_STATES=

# Provider webhook signing keys. Published defaults are embedded; set these to
# survive a provider key rotation without a redeploy. `\n` escapes are accepted
# so a PEM can be supplied on a single line.
# GHL_WEBHOOK_PUBLIC_KEY=
# GHL_LEGACY_WEBHOOK_PUBLIC_KEY=
# Reject a webhook whose signed payload carries no usable timestamp. Durable
# event-id de-duplication stops being a replay defence once the retention
# worker purges the event record.
WEBHOOK_REQUIRE_TIMESTAMP=true

# Onboarding contact-scan ceiling. Truncation is always reported to the user.
CONNECTION_SCAN_LIMIT=5000
CONNECTION_SCAN_MAX_LIMIT=100000

# [V3] contingency. Set false when HighLevel does not grant workflows.readonly:
# the product falls back to Batch plus connection-health Watch cleanly rather
# than offering workflow monitoring that cannot function.
FEATURE_WATCH_WORKFLOWS_ENABLED=true

# Backup automation (server/scripts/backup/).
# BACKUP_S3_BUCKET=logicflower-backups
# BACKUP_S3_PREFIX=logicflower/backups
# BACKUP_REGION=us-east-1
# BACKUP_REPLICA_BUCKET=logicflower-backups-dr
# BACKUP_REPLICA_REGION=eu-west-1
# BACKUP_ENCRYPTION_PASSPHRASE=replace-with-a-long-random-passphrase
# BACKUP_RETENTION_DAYS=35activecampaign:general
CONNECTOR_RELEASE_STATES=

# Provider webhook signing keys. Published defaults are embedded; set these to
# survive a provider key rotation without a redeploy. `\n` escapes are accepted
# so a PEM can be supplied on a single line.
# GHL_WEBHOOK_PUBLIC_KEY=
# GHL_LEGACY_WEBHOOK_PUBLIC_KEY=
# Reject a webhook whose signed payload carries no usable timestamp. Durable
# event-id de-duplication stops being a replay defence once the retention
# worker purges the event record.
WEBHOOK_REQUIRE_TIMESTAMP=true

# Onboarding contact-scan ceiling. Truncation is always reported to the user.
CONNECTION_SCAN_LIMIT=5000
CONNECTION_SCAN_MAX_LIMIT=100000

# [V3] contingency. Set false when HighLevel does not grant workflows.readonly:
# the product falls back to Batch plus connection-health Watch cleanly rather
# than offering workflow monitoring that cannot function.
FEATURE_WATCH_WORKFLOWS_ENABLED=true

# Backup automation (server/scripts/backup/).
# BACKUP_S3_BUCKET=logicflower-backups
# BACKUP_S3_PREFIX=logicflower/backups
# BACKUP_REGION=us-east-1
# BACKUP_REPLICA_BUCKET=logicflower-backups-dr
# BACKUP_REPLICA_REGION=eu-west-1
# BACKUP_ENCRYPTION_PASSPHRASE=replace-with-a-long-random-passphrase
# BACKUP_RETENTION_DAYS=35

# Live acceptance probes (npm run acceptance --prefix server).
# ACCEPTANCE_HOSTNAME=app.example.com
# ACCEPTANCE_API_URL=https://api.example.com
# ACCEPTANCE_EMAIL_TO=deliverability@example.com
# ACCEPTANCE_EVIDENCE_DIR=./acceptance-evidence

# Encrypted artifact storage. Local requires a durable mounted volume; S3 also
# supports S3-compatible providers through ARTIFACT_S3_ENDPOINT.
ARTIFACT_STORAGE_DRIVER=local
ARTIFACT_LOCAL_ROOT=/var/lib/logicflower/artifacts
ARTIFACT_MAX_BYTES=104857600
ARTIFACT_S3_BUCKET=
ARTIFACT_S3_REGION=us-east-1
ARTIFACT_S3_ENDPOINT=
ARTIFACT_S3_FORCE_PATH_STYLE=false
ARTIFACT_S3_KMS_KEY_ID=

# Optional bootstrap owner. Used only by the explicit bootstrap command.
BOOTSTRAP_EMAIL=owner@example.com
BOOTSTRAP_PASSWORD=replace-before-use

# Email delivery. Mailpit values work with docker compose in development.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=LogicFlower <no-reply@logicflower.local>

# Stripe billing (optional until configured).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_SCALE=

# OAuth application credentials. Tokens are stored encrypted per connection.
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REDIRECT_URI=http://localhost:4000/api/v1/connections/ghl/oauth/callback
GHL_OAUTH_SCOPES=contacts.readonly contacts.write locations.readonly workflows.readonly

HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:4000/api/v1/connections/hubspot/oauth/callback
HUBSPOT_OAUTH_SCOPES=crm.objects.contacts.read crm.objects.contacts.write automation

KLAVIYO_CLIENT_ID=
KLAVIYO_CLIENT_SECRET=
KLAVIYO_REDIRECT_URI=http://localhost:4000/api/v1/connections/klaviyo/oauth/callback
KLAVIYO_OAUTH_SCOPES=profiles:read profiles:write events:write flows:read

# ActiveCampaign uses a per-account API token + HTTPS account API URL.
# Store these through /api/v1/connections; do not place them in environment files.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/connections/google/oauth/callback

# Operational controls.
LOG_LEVEL=info
MONITOR_INTERVAL_MS=900000
WORKFLOW_MAX_STEPS=250
WEBHOOK_MAX_AGE_SECONDS=300
WORKFLOW_CONCURRENCY=10
BATCH_CONCURRENCY=4
MONITORING_CONCURRENCY=2
NOTIFICATION_CONCURRENCY=5
OUTBOUND_HTTP_ALLOWLIST=
